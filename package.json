{
  "name": "chatus-private-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:client": "vite --config client/vite.config.ts",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "prepare:deployment": "node scripts/prepare-deployment.mjs",
    "build:client": "vite build --config client/vite.config.ts",
    "check:frontend": "npm run build:client && node scripts/check-frontend.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "acceptance:production": "node scripts/acceptance-production.mjs",
    "census:production": "node scripts/collect-production-legacy-census.mjs",
    "test:browser:agent": "node scripts/run-browser-agent-e2e.mjs",
    "test:browser:workspace": "playwright test --config tests/browser/playwright.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json --noEmit && tsc -p tests/browser/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-istanbul": "^5.1.0",
    "typescript": "^7.0.2",
    "vite": "8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.54.0",
    "ws": "^8.22.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.97",
    "@ai-sdk/openai": "4.0.109",
    "@ai-sdk/provider": "4.0.36",
    "@ai-sdk/react": "4.0.167",
    "@cfworker/json-schema": "^4.1.6",
    "@cloudflare/ai-chat": "0.12.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@zip.js/zip.js": "2.24.0",
    "agents": "0.33.0",
    "ai": "7.0.163",
    "lucide-react": "^1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "saxes": "6.0.0",
    "unpdf": "2.1.0",
    "zod": "^4.6.7"
  }
}
