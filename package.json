{
  "name": "chatus-private-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:client": "vite --config client/vite.config.ts",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "prepare:deployment": "node scripts/prepare-deployment.mjs",
    "build:client": "vite build --config client/vite.config.ts",
    "check:frontend": "npm run build:client && node scripts/check-frontend.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "acceptance:production": "node scripts/acceptance-production.mjs",
    "census:production": "node scripts/collect-production-legacy-census.mjs",
    "test:browser:agent": "node scripts/run-browser-agent-e2e.mjs",
    "test:browser:workspace": "playwright test --config tests/browser/playwright.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json --noEmit && tsc -p tests/browser/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.54.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.40",
    "@ai-sdk/openai": "4.0.44",
    "@ai-sdk/provider": "4.0.7",
    "@ai-sdk/react": "4.0.73",
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/ai-chat": "0.10.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@zip.js/zip.js": "2.8.54",
    "agents": "0.21.0",
    "ai": "7.0.70",
    "lucide-react": "^1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "saxes": "6.0.0",
    "unpdf": "1.8.1",
    "zod": "^4.4.3"
  }
}
