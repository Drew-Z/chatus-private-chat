# This file is for local Worker secrets copied to .dev.vars.
# Production instance settings are GitHub Repository Variables, not Worker secrets:
# CHATUS_WORKER_NAME="chatus-team"
# CHATUS_KV_NAMESPACE_ID="0123456789abcdef0123456789abcdef"
# CHATUS_R2_BUCKET_NAME="chatus-workspace-files"
# CHATUS_PRODUCTION_URL="https://chat.example.com"
# CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID are deployment-only GitHub Secrets;
# do not place Cloudflare deployment credentials in .dev.vars.
# Production releases run through GitHub Actions only; local Wrangler is for development and dry-runs.

# Local-only compatibility fallback. Production deployments use ACCESS_CODES_MODE=managed
# and create/rotate member codes from the authenticated admin surface instead.
ACCESS_CODES="friend:change-this-long-random-code"
ADMIN_TOKEN="change-this-long-admin-token"
# Optional one-time setup for encrypted provider-key management in /react-chat/admin.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Managed provider keys are write-only; admin pages and read APIs never return plaintext.
ROUTE_KEYS_MASTER_KEY=""
SYSTEM_PROMPT="You are a helpful assistant."
BLOCKED_PROMPTS="你好,hi,hello,测试,test,在吗,嗨,哈喽,hey,ping"
MAX_MEMORY_CHARS="4000"

# Provider-pool mode. Keep this as one JSON string in .dev.vars or GitHub Secrets.
# One provider can serve multiple models, and one logical model can list multiple offerings.
ROUTES_CONFIG='{"providers":{"primary-openai":{"label":"Primary OpenAI-compatible","type":"openai-chat","baseUrl":"https://provider-a.example/v1","apiKeyRef":"PRIMARY_OPENAI_KEY","concurrency":"exclusive","queueTimeoutMs":10000,"priority":100,"supportsImages":true},"backup-openai":{"label":"Backup OpenAI-compatible","type":"openai-chat","baseUrl":"https://provider-b.example/v1","apiKeyRef":"BACKUP_OPENAI_KEY","concurrency":"bounded","maxConcurrent":4,"queueTimeoutMs":8000,"priority":60},"anthropic-team":{"label":"Anthropic team","type":"anthropic-messages","baseUrl":"https://api.anthropic.com","apiKeyRef":"ANTHROPIC_KEY","concurrency":"unlimited","priority":80}},"defaults":{"defaultRoute":"general-chat","allowedRoutes":["general-chat","reasoning-mini","claude-code"],"allowBringYourOwnKey":false},"publicAccess":{"enabled":false,"routeId":"general-chat","sessionTtlSeconds":86400,"dailyMessageLimit":20,"minuteMessageLimit":6,"sourceDailyMessageLimit":200,"sourceMinuteMessageLimit":30},"users":{"friend":{"defaultRoute":"general-chat","allowedRoutes":["general-chat","reasoning-mini","claude-code"],"allowBringYourOwnKey":true,"dailyMessageLimit":500,"minuteMessageLimit":12}},"routes":{"general-chat":{"label":"General chat","offerings":[{"providerId":"primary-openai","model":"grok-4.20-multi-agent-xhigh"},{"providerId":"backup-openai","model":"grok-4.20-multi-agent-xhigh","priority":55}],"fallbacks":["claude-code"],"supportsImages":true},"reasoning-mini":{"label":"Reasoning mini","offerings":[{"providerId":"primary-openai","model":"reasoning-mini"},{"providerId":"backup-openai","model":"reasoning-mini"}]},"claude-code":{"label":"Claude Code","offerings":[{"providerId":"anthropic-team","model":"claude-sonnet-4-5"}]}}}'
# queueTimeoutMs must be an integer from 0 to 10000. Higher priority wins; equal-priority
# offerings use only passive telemetry from real tasks. Do not add scheduled model probes.
# publicAccess is disabled by default. When enabled, its route must use a managed
# provider key saved from the admin UI; Worker Secret fallback is not enough for guests.
# Legacy routes with inline type/baseUrl/model/apiKeyRef remain readable during migration.

# Provider key secrets referenced by provider apiKeyRef values.
PRIMARY_OPENAI_KEY="sk-your-primary-upstream-key"
BACKUP_OPENAI_KEY="sk-your-backup-upstream-key"
ANTHROPIC_KEY="sk-ant-your-anthropic-key"

# Optional GitHub Actions secret. Keep it in GitHub, not in .dev.vars.
# WORKER_SECRETS_JSON={"PRIMARY_OPENAI_KEY":"sk-...","BACKUP_OPENAI_KEY":"sk-...","ANTHROPIC_KEY":"sk-ant-..."}

# Legacy single-route fallback. You can omit this when ROUTES_CONFIG is set.
UPSTREAM_API_KEY="sk-your-legacy-upstream-key"
