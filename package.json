{
  "name": "chatus-private-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:client": "vite --config client/vite.config.ts",
    "deploy": "wrangler deploy",
    "build:client": "vite build --config client/vite.config.ts",
    "check:frontend": "npm run build:client && node scripts/check-frontend.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "^5.9.3",
    "vite": "8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.54.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.97",
    "@ai-sdk/openai": "3.0.85",
    "@ai-sdk/provider": "3.0.14",
    "@ai-sdk/react": "3.0.230",
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/ai-chat": "0.9.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "0.17.4",
    "ai": "6.0.228",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  }
}
