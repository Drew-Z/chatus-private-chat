{
  "name": "chatus-private-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:client": "vite --config client/vite.config.ts",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "prepare:deployment": "node scripts/prepare-deployment.mjs",
    "build:client": "vite build --config client/vite.config.ts",
    "check:frontend": "npm run build:client && node scripts/check-frontend.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "acceptance:production": "node scripts/acceptance-production.mjs",
    "test:browser:agent": "node scripts/run-browser-agent-e2e.mjs",
    "test:browser:workspace": "playwright test --config tests/browser/playwright.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json --noEmit && tsc -p tests/browser/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-istanbul": "^4.1.10",
    "typescript": "^5.9.3",
    "vite": "8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.54.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.97",
    "@ai-sdk/openai": "3.0.85",
    "@ai-sdk/provider": "3.0.14",
    "@ai-sdk/react": "3.0.230",
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/ai-chat": "0.9.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@zip.js/zip.js": "2.8.34",
    "agents": "0.17.4",
    "ai": "7.0.47",
    "lucide-react": "^1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "saxes": "6.0.0",
    "unpdf": "1.8.0",
    "zod": "^4.4.3"
  }
}
