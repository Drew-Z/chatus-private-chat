ACCESS_CODES="friend:change-this-long-random-code"
ADMIN_TOKEN="change-this-admin-token"
SYSTEM_PROMPT="You are a helpful assistant."
BLOCKED_PROMPTS="你好,hi,hello,测试,test,在吗,嗨,哈喽,hey,ping"
MAX_MEMORY_CHARS="4000"

# Multi-route mode. Keep this as one JSON string in .dev.vars or GitHub Secrets.
ROUTES_CONFIG="{\"defaults\":{\"defaultRoute\":\"grok-main\",\"allowedRoutes\":[\"grok-main\"],\"allowBringYourOwnKey\":false},\"users\":{\"friend\":{\"defaultRoute\":\"grok-main\",\"allowedRoutes\":[\"grok-main\",\"grok-backup\",\"claude-code\"],\"allowBringYourOwnKey\":true,\"dailyMessageLimit\":500,\"minuteMessageLimit\":12}},\"routes\":{\"grok-main\":{\"label\":\"Grok 主线路\",\"type\":\"openai-chat\",\"baseUrl\":\"https://example-a.com/v1\",\"apiKeyRef\":\"UPSTREAM_GROK_MAIN_KEY\",\"model\":\"grok-4.20-multi-agent-xhigh\",\"fallbacks\":[\"grok-backup\"],\"supportsImages\":true},\"grok-backup\":{\"label\":\"Grok 备用线路\",\"type\":\"openai-chat\",\"baseUrl\":\"https://example-b.com/v1\",\"apiKeyRef\":\"UPSTREAM_GROK_BACKUP_KEY\",\"model\":\"grok-4.20-multi-agent-xhigh\",\"supportsImages\":true},\"claude-code\":{\"label\":\"Claude Code\",\"type\":\"anthropic-messages\",\"baseUrl\":\"https://api.anthropic.com\",\"apiKeyRef\":\"ANTHROPIC_KEY\",\"model\":\"claude-sonnet-4-5\",\"headers\":{\"anthropic-version\":\"2023-06-01\"},\"maxTokens\":4096,\"supportsImages\":true}}}"

# Route key secrets referenced by ROUTES_CONFIG apiKeyRef values.
UPSTREAM_GROK_MAIN_KEY="sk-your-main-upstream-key"
UPSTREAM_GROK_BACKUP_KEY="sk-your-backup-upstream-key"
ANTHROPIC_KEY="sk-ant-your-anthropic-key"

# Optional GitHub Actions secret. Use this when you want route keys uploaded by CI.
# WORKER_SECRETS_JSON={"UPSTREAM_GROK_MAIN_KEY":"sk-...","UPSTREAM_GROK_BACKUP_KEY":"sk-...","ANTHROPIC_KEY":"sk-ant-..."}

# Legacy single-route fallback. You can omit this when ROUTES_CONFIG is set.
UPSTREAM_API_KEY="sk-your-legacy-upstream-key"
